<Window x:Class="PhotoMusicViewer.Views.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanned text" Width="560" Height="440" MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="ResultTextBox" Grid.Row="0" IsReadOnly="True"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Padding="8" BorderThickness="0"
                 Background="{StaticResource PanelBrush}"
                 Foreground="{StaticResource ForegroundBrush}"
                 CaretBrush="{StaticResource ForegroundBrush}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <StackPanel x:Name="CopyButtonsPanel" Orientation="Horizontal"/>
            <Button x:Name="CloseButton" Content="Close" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
