    <Style x:Key="PhotoIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="2,4"/><Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
        <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ButtonHoverBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FF34465E"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PhotoIconToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="2,4"/><Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ButtonHoverBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FF20344E"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Compact bottom-bar controls; image-area controls retain their larger targets. -->
    <Style x:Key="PhotoToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PhotoIconButtonStyle}">
        <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
    </Style>
    <Style x:Key="MediaModeIconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource PhotoIconToggleStyle}">
        <Setter Property="Width" Value="40"/><Setter Property="Height" Value="32"/>
    </Style>
    <Style x:Key="PhotoIconToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="#FF252525"/><Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="#FF484848"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="12"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
