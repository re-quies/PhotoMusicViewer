<Window x:Class="PhotoMusicViewer.Views.BatchRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch rename" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="StartNumberLabel" Text="Start number" Foreground="{StaticResource ForegroundBrush}"/>
        <TextBox x:Name="StartNumberBox" Text="1" Margin="0,4,0,12" Padding="4,2"
                 Background="{StaticResource PanelBrush}"
                 Foreground="{StaticResource ForegroundBrush}"
                 BorderBrush="{StaticResource AccentBrush}"
                 CaretBrush="{StaticResource ForegroundBrush}"/>

        <TextBlock x:Name="PaddingLabel" Text="Digits in number (zero padding)" Foreground="{StaticResource ForegroundBrush}"/>
        <ComboBox x:Name="PaddingCombo" Margin="0,4,0,12" SelectedIndex="2">
            <ComboBoxItem Content="1   (1, 2, 3)"/>
            <ComboBoxItem Content="2   (01, 02, 03)"/>
            <ComboBoxItem Content="3   (001, 002, 003)"/>
            <ComboBoxItem Content="4   (0001, 0002, 0003)"/>
            <ComboBoxItem Content="5   (00001, 00002, 00003)"/>
            <ComboBoxItem Content="6   (000001, 000002, 000003)"/>
        </ComboBox>

        <CheckBox x:Name="RecursiveCheck" Content="Include subfolders"
                  Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,12"/>

        <TextBlock x:Name="InfoText" Text="Only photo and GIF files are renamed. Files whose names are already numbers are skipped. Existing files are never overwritten."
                   Foreground="{StaticResource ForegroundBrush}" Opacity="0.65"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
