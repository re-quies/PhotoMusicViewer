<UserControl x:Class="PhotoMusicViewer.Views.PhotoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             Focusable="True"
             KeyboardNavigation.DirectionalNavigation="None"
             PreviewKeyDown="PhotoView_PreviewKeyDown"
             PreviewMouseDown="PhotoView_PreviewMouseDown"
            PreviewMouseWheel="PhotoView_PreviewMouseWheel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Область изображения -->
        <Grid x:Name="ImageAreaGrid" Grid.Row="0" ClipToBounds="True">
            <Image x:Name="MainImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                   MouseLeftButtonDown="MainImage_MouseLeftButtonDown"
                   MouseLeftButtonUp="MainImage_MouseLeftButtonUp"
                   MouseMove="MainImage_MouseMove">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="ImageTranslateTransform" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <Button x:Name="PrevButton" Content="&#8592;" Width="44" Height="44"
        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"
        FontSize="20" Click="PrevButton_Click" Opacity="0.7"
        Focusable="False" IsTabStop="False"/>
<Button x:Name="NextButton" Content="&#8594;" Width="44" Height="44"
        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0"
        FontSize="20" Click="NextButton_Click" Opacity="0.7"
        Focusable="False" IsTabStop="False"/>

<Button x:Name="GifPlayPauseButton" Content="&#10074;&#10074;" Width="44" Height="44"
        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,60"
        FontSize="16" Click="GifPlayPauseButton_Click" Visibility="Collapsed" Opacity="0.8"
        Focusable="False" IsTabStop="False"/>

            <!-- Оверлей обрезки: затемнение, рамка и маркеры создаются в code-behind -->
            <Canvas x:Name="CropOverlay" Background="Transparent" Visibility="Collapsed"
                    MouseLeftButtonDown="CropOverlay_MouseLeftButtonDown"
                    MouseMove="CropOverlay_MouseMove"
                    MouseLeftButtonUp="CropOverlay_MouseLeftButtonUp"
                    SizeChanged="CropOverlay_SizeChanged"/>

            <StackPanel x:Name="CropActionsPanel" Orientation="Horizontal" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                <Button x:Name="CropSaveButton" Content="Save" Width="90" Margin="4,0"
                        Click="CropSaveButton_Click" Focusable="False" IsTabStop="False"/>
                <Button x:Name="CropCancelButton" Content="Cancel" Width="90" Margin="4,0"
                        Click="CropCancelButton_Click" Focusable="False" IsTabStop="False"/>
            </StackPanel>
        </Grid>
<Grid x:Name="ThumbnailOverlay" Grid.Row="0" Background="{StaticResource BackgroundBrush}"
      Visibility="Collapsed" SizeChanged="ThumbnailOverlay_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ThumbnailItemsControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel x:Name="ThumbnailWrapPanel" Orientation="Horizontal"
                         Loaded="ThumbnailWrapPanel_Loaded"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
    <DataTemplate>
        <Border Margin="2" Background="{StaticResource PanelBrush}"
                Width="{Binding ElementName=ThumbnailWrapPanel, Path=ItemWidth}"
                Height="{Binding ElementName=ThumbnailWrapPanel, Path=ItemHeight}"
                Cursor="Hand"
                MouseLeftButtonDown="ThumbnailItem_MouseLeftButtonDown">
            <Grid>
                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                       Visibility="{Binding ImageVisibility}"/>

                <StackPanel Visibility="{Binding FolderVisibility}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#128193;" FontSize="32" HorizontalAlignment="Center"
                               Foreground="{StaticResource ForegroundBrush}"/>
                    <TextBlock Text="{Binding DisplayName}" FontSize="11" Margin="4,4,4,0"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               TextAlignment="Center"
                               MaxWidth="{Binding ElementName=ThumbnailWrapPanel, Path=ItemWidth}"
                               Foreground="{StaticResource ForegroundBrush}"/>
                </StackPanel>

                <TextBlock Text="&#8592;" FontSize="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding BackVisibility}"
                           Opacity="{Binding BackOpacity}"
                           Foreground="{StaticResource ForegroundBrush}"/>
            </Grid>
        </Border>
    </DataTemplate>
</ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Grid>
        <!-- Нижняя панель -->
        <Grid x:Name="BottomBar" Grid.Row="1" Background="{StaticResource PanelBrush}" Height="42">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <ToggleButton x:Name="PhotoModeToggleBtn" Content="Photo" Width="70" Grid.Column="0"
                  IsChecked="True" Margin="4,4" Click="PhotoModeToggleBtn_Click"
                  Focusable="False" IsTabStop="False"/>
    <ToggleButton x:Name="MusicModeToggleBtn" Content="Music" Width="70" Grid.Column="1"
                  Margin="4,4" Click="MusicModeToggleBtn_Click"
                  Focusable="False" IsTabStop="False"/>

    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
        <Grid>
            <TextBlock x:Name="FileNameDisplay" VerticalAlignment="Center"
                       Foreground="{StaticResource ForegroundBrush}"
                       Text="No file opened" TextTrimming="CharacterEllipsis"
                       Cursor="IBeam"
                       MouseLeftButtonDown="FileNameDisplay_MouseLeftButtonDown"/>
            <TextBox x:Name="FileNameEditBox" VerticalAlignment="Center"
                     Visibility="Collapsed" BorderThickness="0" Padding="0"
                     Background="Transparent" Foreground="{StaticResource ForegroundBrush}"
                     CaretBrush="{StaticResource ForegroundBrush}"
                     LostFocus="FileNameEditBox_LostFocus"
                     PreviewKeyDown="FileNameEditBox_PreviewKeyDown"/>
        </Grid>
        <TextBlock x:Name="FileMetaText" VerticalAlignment="Center" Margin="8,0,0,0"
                   Foreground="{StaticResource ForegroundBrush}" Text=""/>
    </StackPanel>

    <TextBlock x:Name="ZoomText" Grid.Column="3" VerticalAlignment="Center"
               Margin="10,0" Foreground="{StaticResource ForegroundBrush}"
               Text="100%"/>

    <ComboBox x:Name="SortModeCombo" Grid.Column="4" Width="110" Margin="4,4"
              SelectedIndex="1" SelectionChanged="SortModeCombo_SelectionChanged"
              Focusable="False" IsTabStop="False">
        <ComboBoxItem Content="Name"/>
        <ComboBoxItem Content="Date modified"/>
        <ComboBoxItem Content="Size"/>
        <ComboBoxItem Content="Type"/>
    </ComboBox>
    <Button x:Name="SortDirectionButton" Grid.Column="5" Content="&#8593;" Width="30" Margin="4,4"
            Click="SortDirectionButton_Click" Focusable="False" IsTabStop="False"/>

    <Button x:Name="OpenButton" Grid.Column="6" Content="Open" Margin="4,4"
            Click="OpenButton_Click" Focusable="False" IsTabStop="False"/>
    <Button x:Name="RotateButton" Grid.Column="7" Content="Rotate" Margin="4,4"
            Click="RotateButton_Click" Focusable="False" IsTabStop="False"/>
    <Button x:Name="CropButton" Grid.Column="8" Content="Crop" Margin="4,4"
            Click="CropButton_Click" Focusable="False" IsTabStop="False"/>
    <Button x:Name="OcrButton" Grid.Column="9" Content="Scan text" Margin="4,4"
            Click="OcrButton_Click" Focusable="False" IsTabStop="False"/>
    <Button x:Name="StripExifButton" Grid.Column="10" Content="Strip EXIF" Margin="4,4"
            Click="StripExifButton_Click" Focusable="False" IsTabStop="False"/>
    <Button x:Name="BatchRenameButton" Grid.Column="11" Content="Rename all" Margin="4,4"
            Click="BatchRenameButton_Click" Focusable="False" IsTabStop="False"/>
    <Button x:Name="DeleteButton" Grid.Column="12" Content="Delete" Margin="4,4"
            Click="DeleteButton_Click" Focusable="False" IsTabStop="False"/>
    <Button x:Name="ConvertToJpgButton" Grid.Column="13" Content="Convert to JPG" Margin="4,4"
            Click="ConvertToJpgButton_Click" Visibility="Collapsed"
            Focusable="False" IsTabStop="False"/>
    <Button x:Name="GridViewButton" Grid.Column="14" Content="Grid" Margin="4,4"
            Click="GridViewButton_Click" 
            Focusable="False" IsTabStop="False"/>
    <Button x:Name="FullscreenButton" Grid.Column="15" Content="Fullscreen" Margin="4,4"
            Click="FullscreenButton_Click" Focusable="False" IsTabStop="False"/>
    <Button x:Name="LangButton" Grid.Column="16" Content="EN" Width="40" Margin="4,4"
            ToolTip="Switch language / Переключить язык / Cambiar idioma"
            Click="LangButton_Click" Focusable="False" IsTabStop="False"/>
</Grid>
    </Grid>
</UserControl>
