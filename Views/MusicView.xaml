<UserControl x:Class="PhotoMusicViewer.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:PhotoMusicViewer.Services"
             FontSize="13"
             Background="{StaticResource BackgroundBrush}"
             Focusable="True"
             KeyboardNavigation.DirectionalNavigation="None"
             PreviewKeyDown="MusicView_PreviewKeyDown"
             PreviewMouseDown="MusicView_PreviewMouseDown">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Resources/PhotoIcons.xaml"/>
            <ResourceDictionary Source="../Resources/SortControls.xaml"/>
        </ResourceDictionary.MergedDictionaries>
            <services:PhotoActionsWidthConverter x:Key="MusicActionsWidthConverter"/>
            <Style x:Key="MusicIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PhotoToolbarIconButtonStyle}">
                <Style.Triggers><Trigger Property="Tag" Value="Active"><Setter Property="Background" Value="#FF20344E"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="MusicIconToolTipStyle" TargetType="ToolTip" BasedOn="{StaticResource PhotoIconToolTipStyle}">
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Full-height playlist area; only its bottom-right corner is reserved. -->
        <Grid x:Name="MusicPlaylistArea" Grid.Row="0" Background="{StaticResource BackgroundBrush}" ClipToBounds="True" LayoutUpdated="MusicPlaylistArea_LayoutUpdated">
        <!-- Список треков -->
        <ListBox x:Name="TrackListBox" Grid.Row="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         Background="{StaticResource BackgroundBrush}"
         Foreground="{StaticResource ForegroundBrush}"
         BorderThickness="0"
         AllowDrop="True"
         DragEnter="TrackListBox_DragEnter"
         Drop="TrackListBox_Drop"
         PreviewMouseLeftButtonDown="TrackListBox_PreviewMouseLeftButtonDown"
         PreviewMouseLeftButtonUp="TrackListBox_PreviewMouseLeftButtonUp"
         MouseMove="TrackListBox_MouseMove"
         MouseDoubleClick="TrackListBox_MouseDoubleClick" FontSize="13">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <!-- Клик по названию - переименование; пустое место правее - перетаскивание/выбор -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent">
                        <TextBlock x:Name="TrackTitleText" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" Cursor="IBeam"
                                   MouseLeftButtonDown="TrackTitle_MouseLeftButtonDown" FontSize="13">
                            <TextBlock.ToolTip><ToolTip Style="{StaticResource MusicIconToolTipStyle}" Content="{Binding PlacementTarget.DataContext.DisplayName, RelativeSource={RelativeSource Self}}"/></TextBlock.ToolTip>
                        </TextBlock>
                        <TextBox x:Name="TrackEditBox" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 MinWidth="160" Visibility="Collapsed" BorderThickness="0" Padding="0"
                                 Background="Transparent" Foreground="{StaticResource ForegroundBrush}"
                                 CaretBrush="{StaticResource ForegroundBrush}"
                                 LostFocus="TrackEditBox_LostFocus"
                                 PreviewKeyDown="TrackEditBox_PreviewKeyDown" FontSize="13"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter TargetName="TrackTitleText" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="TrackEditBox" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom-right controls share the playlist background, not the footer. -->
        <Border x:Name="MusicDetailsBar" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Panel.ZIndex="1" Width="444" Height="28" Background="{StaticResource BackgroundBrush}" Padding="8,0" BorderThickness="0" ClipToBounds="True">
            <Grid VerticalAlignment="Center" Height="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TrackCountText" Grid.Column="0" Margin="0,0,8,0" MaxWidth="110" VerticalAlignment="Center" Opacity="0.6" Foreground="{StaticResource ForegroundBrush}" TextTrimming="CharacterEllipsis" FontSize="13">
                        <TextBlock.ToolTip><ToolTip Style="{StaticResource MusicIconToolTipStyle}" Content="{Binding PlacementTarget.Text, RelativeSource={RelativeSource Self}}"/></TextBlock.ToolTip>
                    </TextBlock>
                <Grid x:Name="SpeedControls" Grid.Column="1" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image x:Name="SpeedIndicator" Grid.Column="0" Source="{StaticResource PhotoIcon.Speed}" Width="18" Height="18" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <Slider x:Name="SpeedSlider" Grid.Column="1" Height="18" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SpeedSlider_ValueChanged" PreviewMouseLeftButtonDown="SpeedSlider_PreviewMouseLeftButtonDown" PreviewMouseMove="SpeedSlider_PreviewMouseMove" PreviewMouseLeftButtonUp="SpeedSlider_PreviewMouseLeftButtonUp" PreviewMouseWheel="SpeedSlider_PreviewMouseWheel"/>
                    <TextBlock x:Name="SpeedText" Grid.Column="2" Text="1.0x" MinWidth="34" Margin="4,0,0,0" Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="SpeedText_MouseLeftButtonDown" FontSize="13"/>
                </Grid>
                <Grid x:Name="VolumeControls" Grid.Column="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image x:Name="VolumeIndicator" Grid.Column="0" Source="{StaticResource PhotoIcon.Volume}" Width="18" Height="18" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Height="18" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown" PreviewMouseMove="VolumeSlider_PreviewMouseMove" PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp" PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"/>
                    <TextBlock x:Name="VolumePercentText" Grid.Column="2" Text="80%" MinWidth="34" Margin="4,0,0,0" Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center" FontSize="13"/>
                </Grid>
            </Grid>
        </Border>

        </Grid>

        <!-- Compact footer: mode selectors stay at the same coordinates as PhotoView. -->
        <Border x:Name="BottomBar" Grid.Row="1" Background="{StaticResource PanelBrush}" Height="{StaticResource MediaControlPanelHeight}" Padding="0,0,8,0">
            <Grid x:Name="MusicToolbarBody" SizeChanged="MusicToolbarBody_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="MusicModeSelectors" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="PhotoModeToggleBtn" Style="{StaticResource MediaModeIconToggleStyle}" Click="PhotoModeToggleBtn_Click">
                        <Image Source="{StaticResource PhotoIcon.Photo}" Width="20" Height="20" IsHitTestVisible="False"/>
                    </ToggleButton>
                    <ToggleButton x:Name="MusicModeToggleBtn" IsChecked="True" Style="{StaticResource MediaModeIconToggleStyle}" Click="MusicModeToggleBtn_Click">
                        <Image Source="{StaticResource PhotoIcon.Music}" Width="20" Height="20" IsHitTestVisible="False"/>
                    </ToggleButton>
                </StackPanel>
                <!-- Center: only the seek bar, current title and playback time. -->
                <Grid x:Name="MusicPlaybackCenter" Grid.Column="1" Margin="10,0" Height="34" VerticalAlignment="Center" ClipToBounds="True" SizeChanged="MusicPlaybackCenter_SizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="17"/></Grid.RowDefinitions>
                    <Slider x:Name="SeekSlider" Grid.Row="0" Height="16" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown" PreviewMouseMove="SeekSlider_PreviewMouseMove" Tag="{Binding Text, ElementName=TimeText}">
                        <Slider.ToolTip><ToolTip Style="{StaticResource MusicIconToolTipStyle}" Content="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"/></Slider.ToolTip>
                    </Slider>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="NowPlayingText" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}" Text="No track loaded" TextTrimming="CharacterEllipsis" FontSize="13">
                        <TextBlock.ToolTip><ToolTip Style="{StaticResource MusicIconToolTipStyle}" Content="{Binding PlacementTarget.Text, RelativeSource={RelativeSource Self}}"/></TextBlock.ToolTip>
                    </TextBlock>
                        <TextBlock x:Name="TimeText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}" Text="00:00 / 00:00" FontSize="13"/>
                    </Grid>
                </Grid>
                <Viewbox x:Name="MusicActionViewport" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly" SizeChanged="MusicActionViewport_SizeChanged">
                    <Viewbox.MaxWidth><MultiBinding Converter="{StaticResource MusicActionsWidthConverter}" ConverterParameter="76">
                        <Binding ElementName="BottomBar" Path="ActualWidth"/>
                        <Binding ElementName="MusicModeSelectors" Path="ActualWidth"/>
                        <Binding ElementName="BottomBar" Path="Padding"/>
                    </MultiBinding></Viewbox.MaxWidth>
                    <StackPanel x:Name="MusicActionsPanel" Orientation="Horizontal">
                        <Button x:Name="AddFolderButton" Style="{StaticResource MusicIconButtonStyle}" Click="AddFolderButton_Click">
                            <Image x:Name="AddFolderIcon" Source="{StaticResource PhotoIcon.AddFolder}" Width="20" Height="20" IsHitTestVisible="False"/>
                        </Button>
                        <ComboBox x:Name="SortModeCombo" Style="{StaticResource MediaSortComboBoxStyle}" Width="110" Height="32" Margin="2,4" SelectedIndex="0" SelectionChanged="SortModeCombo_SelectionChanged" Focusable="False" IsTabStop="False" FontSize="13">
                            <ComboBoxItem Content="Name" FontSize="13"/><ComboBoxItem Content="Date modified" FontSize="13"/>
                            <ComboBoxItem Content="Size" FontSize="13"/><ComboBoxItem Content="Type" FontSize="13"/>
                        </ComboBox>
                        <Button x:Name="SortDirectionButton" Style="{StaticResource MusicIconButtonStyle}" Click="SortDirectionButton_Click">
                            <Image x:Name="MusicSortDirectionIcon" Source="{StaticResource PhotoIcon.SortUp}" Width="20" Height="20" IsHitTestVisible="False"/>
                        </Button>
                        <Button x:Name="ShuffleButton" Style="{StaticResource MusicIconButtonStyle}" Click="ShuffleButton_Click">
                            <Image x:Name="ShuffleIcon" Source="{StaticResource PhotoIcon.Shuffle}" Width="20" Height="20" IsHitTestVisible="False"/>
                        </Button>
                        <Button x:Name="RepeatButton" Style="{StaticResource MusicIconButtonStyle}" Click="RepeatButton_Click">
                            <Image x:Name="RepeatIcon" Source="{StaticResource PhotoIcon.RepeatOff}" Width="20" Height="20" IsHitTestVisible="False"/>
                        </Button>
                        <Button x:Name="PrevTrackButton" Style="{StaticResource MusicIconButtonStyle}" Click="PrevTrackButton_Click">
                            <Image x:Name="PreviousTrackIcon" Source="{StaticResource PhotoIcon.PreviousTrack}" Width="20" Height="20" IsHitTestVisible="False"/>
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource MusicIconButtonStyle}" Click="PlayPauseButton_Click">
                            <Image x:Name="MusicPlaybackIcon" Source="{StaticResource PhotoIcon.Play}" Width="20" Height="20" IsHitTestVisible="False"/>
                        </Button>
                        <Button x:Name="NextTrackButton" Style="{StaticResource MusicIconButtonStyle}" Click="NextTrackButton_Click">
                            <Image x:Name="NextTrackIcon" Source="{StaticResource PhotoIcon.NextTrack}" Width="20" Height="20" IsHitTestVisible="False"/>
                        </Button>
                        <Button x:Name="RemoveTrackButton" Style="{StaticResource MusicIconButtonStyle}" Click="RemoveTrackButton_Click">
                            <Image x:Name="RemoveTrackIcon" Source="{StaticResource PhotoIcon.RemoveTrack}" Width="20" Height="20" IsHitTestVisible="False"/>
                        </Button>
                        <Button x:Name="ClearButton" Style="{StaticResource MusicIconButtonStyle}" Click="ClearButton_Click">
                            <Image x:Name="ClearPlaylistIcon" Source="{StaticResource PhotoIcon.ClearPlaylist}" Width="20" Height="20" IsHitTestVisible="False"/>
                        </Button>
                    </StackPanel>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
