<Application x:Class="PhotoMusicViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Тёмная тема: единственная тема приложения -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#FF121212"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#FF1E1E1E"/>
            <SolidColorBrush x:Key="ForegroundBrush" Color="#FFE0E0E0"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF3D7EFF"/>
            <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF2A2A2A"/>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>