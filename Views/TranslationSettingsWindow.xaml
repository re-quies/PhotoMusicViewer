<Window x:Class="PhotoMusicViewer.Views.TranslationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="720" Height="760"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <!-- ============================ ИНТЕРФЕЙС ============================ -->
                <!-- Язык при запуске, сортировка, громкость: preferences.json, без путей и имён файлов -->
                <TextBlock x:Name="InterfaceHeader" Text="Interface" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>

                <TextBlock x:Name="StartupLanguageLabel" Text="Language at startup" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="StartupLanguageCombo" Width="220" HorizontalAlignment="Left">
                    <ComboBoxItem Tag="System" Content="As in Windows"/>
                    <ComboBoxItem Tag="English" Content="English"/>
                    <ComboBoxItem Tag="Russian" Content="Русский"/>
                    <ComboBoxItem Tag="Spanish" Content="Español"/>
                </ComboBox>
                <CheckBox x:Name="RememberLanguageCheck" Margin="0,6,0,0"
                          Content="Remember the language chosen with the EN / RU / ES button"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="PhotoSortLabel" Text="Photo sorting" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="PhotoSortCombo" Width="140">
                                <ComboBoxItem Content="Name"/>
                                <ComboBoxItem Content="Date modified"/>
                                <ComboBoxItem Content="Size"/>
                                <ComboBoxItem Content="Type"/>
                            </ComboBox>
                            <ComboBox x:Name="PhotoSortDirectionCombo" Width="140" Margin="6,0,0,0">
                                <ComboBoxItem Content="Ascending ↑"/>
                                <ComboBoxItem Content="Descending ↓"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="MusicSortLabel" Text="Playlist sorting" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="MusicSortCombo" Width="140">
                                <ComboBoxItem Content="Name"/>
                                <ComboBoxItem Content="Date modified"/>
                                <ComboBoxItem Content="Size"/>
                                <ComboBoxItem Content="Type"/>
                            </ComboBox>
                            <ComboBox x:Name="MusicSortDirectionCombo" Width="140" Margin="6,0,0,0">
                                <ComboBoxItem Content="Ascending ↑"/>
                                <ComboBoxItem Content="Descending ↓"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="RememberSortCheck" Margin="0,6,0,0"
                          Content="Remember the sorting chosen on the toolbar"/>

                <TextBlock x:Name="VolumeLabel" Text="Volume at startup" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="StartupVolumeSlider" Width="220" Minimum="0" Maximum="100"
                            SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="StartupVolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="StartupVolumeText" Text="80%" Margin="8,0,0,0" MinWidth="40" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Name="RememberVolumeCheck" Margin="0,6,0,0"
                          Content="Remember the last volume"/>
                <CheckBox x:Name="ConfirmDeleteCheck" Margin="0,10,0,0"
                          Content="Ask before moving a photo to the Recycle Bin"/>
                <TextBlock x:Name="ConfirmDeleteHint" Style="{StaticResource HintText}" Margin="22,0,0,0"/>
                <TextBlock x:Name="InterfaceHint" Style="{StaticResource HintText}"/>

                <!-- ============================ КЛЮЧИ ============================ -->
                <TextBlock x:Name="KeysHeader" Text="API keys" Style="{StaticResource SectionHeader}"/>

                <TextBlock x:Name="DeepLKeyLabel" Text="DeepL API key" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <PasswordBox x:Name="DeepLKeyMasked"/>
                    <TextBox x:Name="DeepLKeyPlain" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="DeepLKeyHint" Style="{StaticResource HintText}"
                           Text="Free keys end with :fx and use api-free.deepl.com automatically."/>

                <TextBlock x:Name="GoogleKeyLabel" Text="Google API key" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <PasswordBox x:Name="GoogleKeyMasked"/>
                    <TextBox x:Name="GoogleKeyPlain" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="GoogleKeyHint" Style="{StaticResource HintText}"
                           Text="One key works for both Gemini and Cloud Translation if both APIs are enabled for it."/>

                <TextBlock x:Name="QwenKeyLabel" Text="Qwen API key" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <PasswordBox x:Name="QwenKeyMasked"/>
                    <TextBox x:Name="QwenKeyPlain" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="QwenKeyHint" Style="{StaticResource HintText}"
                           Text="Key from Alibaba Cloud Model Studio (DashScope). It only works in the region where it was created."/>

                <CheckBox x:Name="ShowKeysCheck" Content="Show keys" Margin="0,10,0,0"
                          Checked="ShowKeysCheck_Changed" Unchecked="ShowKeysCheck_Changed"/>

                <!-- ============================ ЯЗЫКИ ============================ -->
                <TextBlock x:Name="LanguagesHeader" Text="Languages" Style="{StaticResource SectionHeader}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TargetLangLabel" Text="Translate into" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TargetLangCombo"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="SourceLangLabel" Text="Source language" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="SourceLangCombo"/>
                    </StackPanel>
                </Grid>

                <!-- ============================ GOOGLE ============================ -->
                <TextBlock x:Name="GoogleHeader" Text="Google" Style="{StaticResource SectionHeader}"/>

                <TextBlock x:Name="GoogleEngineLabel" Text="Service for text translation" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="GoogleEngineCombo" SelectionChanged="GoogleEngineCombo_SelectionChanged">
                    <ComboBoxItem Tag="Gemini" Content="Gemini (model + prompts, can read images)"/>
                    <ComboBoxItem Tag="CloudTranslationV2" Content="Cloud Translation v2 (fast, no prompts)"/>
                </ComboBox>

                <TextBlock x:Name="GeminiModelLabel" Text="Gemini model" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="GeminiModelCombo" Grid.Column="0" IsEditable="True"/>
                    <Button x:Name="LoadModelsButton" Grid.Column="1" Content="Load list" Margin="8,0,0,0"
                            Click="LoadModelsButton_Click"/>
                </Grid>
                <TextBlock x:Name="GeminiModelHint" Style="{StaticResource HintText}"
                           Text="Flash models are faster and cheaper; Pro models are more accurate on messy photos."/>

                <TextBlock x:Name="TemperatureLabel" Text="Temperature (0 = most literal)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TemperatureBox" Width="90" HorizontalAlignment="Left"/>

                <!-- ============================ DEEPL ============================ -->
                <TextBlock x:Name="DeepLHeader" Text="DeepL" Style="{StaticResource SectionHeader}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="DeepLEndpointLabel" Text="Endpoint" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DeepLEndpointCombo">
                            <ComboBoxItem Tag="Auto" Content="Auto"/>
                            <ComboBoxItem Tag="Free" Content="Free"/>
                            <ComboBoxItem Tag="Pro" Content="Pro"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="DeepLFormalityLabel" Text="Formality" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DeepLFormalityCombo">
                            <ComboBoxItem Tag="default" Content="default"/>
                            <ComboBoxItem Tag="prefer_more" Content="prefer formal"/>
                            <ComboBoxItem Tag="prefer_less" Content="prefer informal"/>
                            <ComboBoxItem Tag="more" Content="formal (strict)"/>
                            <ComboBoxItem Tag="less" Content="informal (strict)"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock x:Name="DeepLModelTypeLabel" Text="Model" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DeepLModelTypeCombo">
                            <ComboBoxItem Tag="prefer_quality_optimized" Content="prefer quality"/>
                            <ComboBoxItem Tag="quality_optimized" Content="quality (next-gen)"/>
                            <ComboBoxItem Tag="latency_optimized" Content="speed"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="DeepLContextLabel" Text="Context (not translated, guides word choice)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DeepLContextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="52"
                         VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="DeepLContextHint" Style="{StaticResource HintText}"
                           Text="DeepL has no prompts; this field is the closest equivalent. Prompts below apply to Gemini and Qwen."/>

                <CheckBox x:Name="PreserveFormattingCheck" Content="Preserve formatting and line breaks" Margin="0,10,0,0"/>

                <!-- ============================= QWEN ============================= -->
                <TextBlock x:Name="QwenHeader" Text="Qwen" Style="{StaticResource SectionHeader}"/>

                <TextBlock x:Name="QwenRegionLabel" Text="Region (must match the key)" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="QwenRegionCombo" Width="280" HorizontalAlignment="Left">
                    <ComboBoxItem Tag="International" Content="International (Singapore)"/>
                    <ComboBoxItem Tag="Beijing" Content="China (Beijing)"/>
                    <ComboBoxItem Tag="UsVirginia" Content="US (Virginia)"/>
                    <ComboBoxItem Tag="CodingPlan" Content="Coding Plan (sk-sp-... key)"/>
                    <ComboBoxItem Tag="Custom" Content="Own Base URL (workspace)"/>
                </ComboBox>

                <TextBlock x:Name="QwenBaseUrlLabel" Text="Own Base URL" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="QwenBaseUrlBox"/>
                <CheckBox x:Name="QwenLoopbackHttpCheck" Content="Allow HTTP only for local loopback" Margin="0,6,0,0"/>
                <TextBlock x:Name="QwenBaseUrlHint" Style="{StaticResource HintText}"
                           Text="Used with the option above. Example: https://your-workspace-id.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"/>

                <TextBlock x:Name="QwenModelLabel" Text="Model for text" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="QwenModelCombo" Grid.Column="0" IsEditable="True"/>
                    <Button x:Name="LoadQwenModelsButton" Grid.Column="1" Content="Load list" Margin="8,0,0,0"
                            Click="LoadQwenModelsButton_Click"/>
                </Grid>

                <TextBlock x:Name="QwenVisionModelLabel" Text="Model for photos" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="QwenVisionModelCombo" IsEditable="True"/>
                <TextBlock x:Name="QwenVisionModelHint" Style="{StaticResource HintText}"
                           Text="Only VL models can read images: qwen-vl-max, qwen-vl-plus, qwen-vl-ocr."/>

                <TextBlock x:Name="QwenTemperatureLabel" Text="Temperature (0 = most literal)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="QwenTemperatureBox" Width="90" HorizontalAlignment="Left"/>

                <!-- ============================ ПРОМТЫ ============================ -->
                <TextBlock x:Name="PromptsHeader" Text="Prompts (Gemini and Qwen)" Style="{StaticResource SectionHeader}"/>

                <TextBlock x:Name="PromptsHint" Style="{StaticResource HintText}" Margin="0,0,0,6"
                           Text="Placeholders: {text} = text to translate, {target} = target language, {source} = source language."/>

                <Grid Height="210">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="PromptList" Grid.Row="0" Grid.Column="0"
                             Background="{StaticResource PanelBrush}"
                             Foreground="{StaticResource ForegroundBrush}"
                             BorderBrush="#FF3A3A3A" BorderThickness="1"
                             SelectionChanged="PromptList_SelectionChanged"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="AddPromptButton" Content="Add" Width="62" Margin="0,0,4,0" Click="AddPrompt_Click"/>
                        <Button x:Name="DeletePromptButton" Content="Delete" Width="62" Margin="0,0,4,0" Click="DeletePrompt_Click"/>
                        <Button x:Name="ResetPromptsButton" Content="Reset" Width="62" Click="ResetPrompts_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
                        <TextBlock x:Name="PromptNameLabel" Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                        <TextBox x:Name="PromptNameBox" LostFocus="PromptNameBox_LostFocus"/>
                        <TextBlock x:Name="PromptTextLabel" Text="Prompt text" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PromptTextBox" Height="140" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ImageOcrPromptLabel" Text="Prompt for &quot;photo &#8594; text&quot;" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ImageOcrPromptBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock x:Name="ImageOcrTranslatePromptLabel" Text="Prompt for &quot;photo &#8594; text + translation&quot;" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ImageOcrTranslatePromptBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="ImageOcrTranslateHint" Style="{StaticResource HintText}"
                           Text="Keep the === TEXT === and === TRANSLATION === markers so the app can split the answer into two panes."/>

                <!-- ====================== СЕТЬ И ПРИВАТНОСТЬ ====================== -->
                <TextBlock x:Name="PrivacyHeader" Text="Network and privacy" Style="{StaticResource SectionHeader}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TimeoutLabel" Text="Timeout, seconds" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TimeoutBox"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="MaxImageSideLabel" Text="Max image side before sending, px" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="MaxImageSideCombo" IsEditable="True"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="StripMetaCheck" Margin="0,12,0,6"
                          Content="Re-encode the photo before sending (removes EXIF/GPS, sends pixels only)"/>
                <CheckBox x:Name="AskNetworkCheck"
                          Content="Ask for confirmation before sending — separately for text and for photos"/>
                <CheckBox x:Name="PersistCheck" Checked="PersistCheck_Changed" Unchecked="PersistCheck_Changed"
                          Content="Remember settings and keys on this computer (keys are encrypted with Windows DPAPI)"/>

                <TextBlock x:Name="PersistPathText" Style="{StaticResource HintText}" Margin="22,0,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                    <Button x:Name="DeleteFileButton" Content="Delete settings file" Click="DeleteFile_Click"/>
                </StackPanel>

                <CheckBox x:Name="LogCheck" Margin="0,16,0,6"
                          Checked="LogCheck_Changed" Unchecked="LogCheck_Changed"
                          Content="Keep a diagnostic log (error types only, no file names or text)"/>

                <TextBlock x:Name="LogPathText" Style="{StaticResource HintText}" Margin="22,0,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                    <Button x:Name="OpenLogFolderButton" Content="Open log folder" Margin="0,0,8,0" Click="OpenLogFolder_Click"/>
                    <Button x:Name="DeleteLogButton" Content="Delete log" Click="DeleteLog_Click"/>
                </StackPanel>

                <!-- Уборка следов в Windows: обе галочки по умолчанию выключены -->
                <TextBlock x:Name="TracesHeader" Text="Traces in Windows" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                <CheckBox x:Name="CleanRecentCheck" Margin="0,6,0,0"
                          Checked="TraceCleanupCheck_Changed" Unchecked="TraceCleanupCheck_Changed"
                          Content="Remove opened files from Recent items"/>
                <CheckBox x:Name="CleanRegistryCheck" Margin="0,6,0,0"
                          Checked="TraceCleanupCheck_Changed" Unchecked="TraceCleanupCheck_Changed"
                          Content="Remove opened files from Explorer registry history"/>
                <TextBlock x:Name="TracesHint" Style="{StaticResource HintText}" Margin="22,0,0,0"/>

                <!-- Дисковый кэш миниатюр: по умолчанию выключен (след на диске) -->
                <CheckBox x:Name="ThumbCacheCheck" Margin="0,16,0,0"
                          Checked="ThumbCacheCheck_Changed" Unchecked="ThumbCacheCheck_Changed"
                          Content="Keep thumbnails on disk (the thumbnail grid opens faster)"/>
                <TextBlock x:Name="ThumbCacheText" Style="{StaticResource HintText}" Margin="22,0,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                    <Button x:Name="ClearThumbCacheButton" Content="Clear thumbnail cache" Click="ClearThumbCache_Click"/>
                </StackPanel>

                <TextBlock x:Name="PrivacyNotice" Style="{StaticResource HintText}" Margin="0,12,0,0"
                           Text="Everything else in this app stays offline. Text or photos leave your computer only when you press a translate button, and only to the service you pressed."/>

                <!-- ============================ О ПРОГРАММЕ ============================ -->
                <TextBlock x:Name="AboutHeader" Text="About" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="VersionText" Text="PhotoMusicViewer" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="GitHubButton" Content="Open project page on GitHub" Click="GitHub_Click"/>
                </StackPanel>
                <TextBlock x:Name="GitHubHint" Style="{StaticResource HintText}"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,10,0,0" Text=""
                   Foreground="{StaticResource ForegroundBrush}" Opacity="0.8"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="TestButton" Content="Test keys" Width="120" Margin="0,0,8,0" Click="Test_Click"/>
            <Button x:Name="OkButton" Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
